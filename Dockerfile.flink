# Flink 1.18 + Java 11, with PyFlink and the ML libs the fusion job needs
# to load the MLP / autoencoder models and their scalers.
FROM flink:1.18.1-scala_2.12-java11

ARG FLINK_VERSION=1.18.1
ARG KAFKA_CONNECTOR_VERSION=3.0.2-1.18

# --- Python 3.10 + PyFlink -------------------------------------------------
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        python3 python3-pip python3-dev python3-venv build-essential curl && \
    ln -sf /usr/bin/python3 /usr/bin/python && \
    rm -rf /var/lib/apt/lists/*

COPY requirements.txt /tmp/requirements.txt
RUN pip3 install --no-cache-dir --upgrade pip && \
    pip3 install --no-cache-dir -r /tmp/requirements.txt

# --- Kafka connector jar (Flink's Python Kafka connectors need this on the
#     classpath - it is NOT bundled with the base image or with pyflink) ---
RUN curl -fSL -o /opt/flink/lib/flink-sql-connector-kafka-${KAFKA_CONNECTOR_VERSION}.jar \
    https://repo1.maven.org/maven2/org/apache/flink/flink-sql-connector-kafka/${KAFKA_CONNECTOR_VERSION}/flink-sql-connector-kafka-${KAFKA_CONNECTOR_VERSION}.jar

# Job/model code is bind-mounted at runtime (see docker-compose.yml) into
# /opt/flink/usrlib/flink_jobs and /opt/flink/usrlib/models, so it isn't
# baked into the image - that keeps rebuilds fast while you iterate on the
# Python job logic and lets you swap retrained models without a rebuild.
RUN mkdir -p /opt/flink/checkpoints
